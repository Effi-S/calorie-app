#: include calorie_count/src/kv_files/entry_add_screen.kv
#: include calorie_count/src/kv_files/foods_screen.kv
#: include calorie_count/src/kv_files/trends_screen.kv
#: include calorie_count/src/kv_files/daily_screen.kv
#: include calorie_count/src/kv_files/nav_drawer.kv

Screen:
    MDNavigationLayout:
        ScreenManager:
            id: screen_manager
            Screen:
                name: "default"
                MDBoxLayout:
                    orientation: "vertical"
                    MDTopAppBar:
                        id: top_app_bar
                        type: "small"
                        size_hint_y: None
                        MDTopAppBarLeadingButtonContainer:
                            MDActionTopAppBarButton:
                                icon: "menu"
                                on_release: nav_drawer.set_state("open")
                        MDTopAppBarTitle:
                            text: "Calorie Counter"
                        MDTopAppBarTrailingButtonContainer:
                            MDActionTopAppBarButton:
                                icon: "share-variant"
                                on_release: app.open_xlsx_dropdown()
                            MDActionTopAppBarButton:
                                icon: "invert-colors"
                                on_release: app.show_theme_picker()

                    ScreenManager:
                        id: tab_manager
                        Screen:
                            name: "my_foods"
                            MealsScreen:
                                id: foods_screen
                        Screen:
                            name: "add_entry"
                            EntryAddScreen:
                                id: entry_add_screen
                        Screen:
                            name: "daily_screen"
                            DailyScreen:
                                id: daily_screen
                        Screen:
                            name: "trends_screen"
                            TrendsScreen:
                                id: trends_screen

                    MDNavigationBar:
                        id: bottom_navigation
                        on_switch_tabs: app.on_switch_tabs(*args)
                        NavItem:
                            screen: "my_foods"
                            MDNavigationItemIcon:
                                icon: "basket"
                            MDNavigationItemLabel:
                                text: "My Foods"
                        NavItem:
                            screen: "add_entry"
                            active: True
                            MDNavigationItemIcon:
                                icon: "calendar-plus"
                            MDNavigationItemLabel:
                                text: "Add Entry"
                        NavItem:
                            screen: "daily_screen"
                            MDNavigationItemIcon:
                                icon: "view-day-outline"
                            MDNavigationItemLabel:
                                text: "Today"
                        NavItem:
                            screen: "trends_screen"
                            MDNavigationItemIcon:
                                icon: "chart-bell-curve-cumulative"
                            MDNavigationItemLabel:
                                text: "Trends"

        MDNavigationDrawer:
            id: nav_drawer
            ContentNavigationDrawer:
